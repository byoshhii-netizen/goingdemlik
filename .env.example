POSTGRES_USER=demlik_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=demlikforum
DATABASE_URL=postgresql://demlik_app:replace-with-a-long-random-password@localhost:5432/demlikforum

PORT=3000
APP_SECRET=replace-with-a-long-random-secret
SITE_URL=https://cigcig.xyz

PGPOOL_MAX=10
API_RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=15
ADMIN_AUTH_RATE_LIMIT_MAX=20

VMB_PANEL_USERNAME=replace-with-a-unique-admin-name
VMB_PANEL_PASSWORD=replace-with-a-long-random-password

UPLOAD_DIR=/data/uploads

# Ücretsiz/ucuz medya depolama için tercih edilen seçenekler:
# R2 kullanacaksan:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#
# Cloudinary kullanacaksan:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
#
# Alternatif olarak Railway, Render veya başka sunucuda doğrudan depolama için:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
